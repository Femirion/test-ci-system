<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001" author="AlexVostriakov">
        <createTable tableName="triggers">
            <column name="id" type="UUID">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="type" type="VARCHAR(50)"/>
            <column name="repository" type="VARCHAR(255)"/>
            <column name="branch" type="VARCHAR(255)"/>
            <column name="destination_queue" type="VARCHAR(255)"/>
            <column name="cron" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="job_name" type="VARCHAR(255)"/>
            <column name="group_name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
