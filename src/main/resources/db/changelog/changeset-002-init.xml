<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001" author="AlexVostriakov">
        <createIndex indexName="idx_triggers_created_at"
                     tableName="triggers">
            <column name="created_at"/>
        </createIndex>

        <createIndex indexName="idx_triggers_repository"
                     tableName="triggers">
            <column name="repository"/>
        </createIndex>

        <createIndex indexName="idx_triggers_branch"
                     tableName="triggers">
            <column name="branch"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
